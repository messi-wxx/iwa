<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/inst_filter_title"
        android:textColor="@color/navy"
        android:textSize="18sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/inst_filter_code"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etCode"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_meter"
                android:hint="@string/inst_filter_code_hint"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textColor="@color/navy"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/inst_filter_address"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etAddress"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_meter"
                android:hint="@string/inst_filter_address_hint"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textColor="@color/navy"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/inst_filter_applicant"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etApplicant"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_meter"
                android:hint="@string/inst_filter_applicant_hint"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textColor="@color/navy"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/inst_filter_date"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <include
                android:id="@+id/dateRangeBar"
                layout="@layout/include_inst_date_range"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/inst_filter_type"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp"
                app:selectionRequired="false"
                app:singleLine="false"
                app:singleSelection="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipType1"
                    style="@style/IwaFilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="居民报装" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipType2"
                    style="@style/IwaFilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="单位报装" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipType3"
                    style="@style/IwaFilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="小区报装" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/inst_filter_state"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp"
                app:selectionRequired="false"
                app:singleLine="false"
                app:singleSelection="false">

                <com.google.android.material.chip.Chip android:id="@+id/chipState1" style="@style/IwaFilterChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="申请未通过" />
                <com.google.android.material.chip.Chip android:id="@+id/chipState2" style="@style/IwaFilterChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="终止" />
                <com.google.android.material.chip.Chip android:id="@+id/chipState3" style="@style/IwaFilterChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="暂停" />
                <com.google.android.material.chip.Chip android:id="@+id/chipState4" style="@style/IwaFilterChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="待受理" />
                <com.google.android.material.chip.Chip android:id="@+id/chipState5" style="@style/IwaFilterChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="进行中" />
                <com.google.android.material.chip.Chip android:id="@+id/chipState6" style="@style/IwaFilterChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="已完成" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnReset"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_ghost_btn"
            android:gravity="center"
            android:text="@string/inst_reset"
            android:textColor="@color/primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnConfirm"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_primary_btn"
            android:gravity="center"
            android:text="@string/inst_filter_confirm"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
