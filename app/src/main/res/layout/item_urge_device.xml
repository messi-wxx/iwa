<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/_280sdp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/_10sdp"
    android:background="@drawable/bg_meter_card"
    android:orientation="vertical"
    android:padding="@dimen/_12sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="@dimen/_72sdp"
            android:layout_height="wrap_content"
            android:text="@string/urge_meter_code"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_12ssp" />

        <TextView
            android:id="@+id/tvMeterCode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/navy"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold"
            tools:text="A12345678" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="@dimen/_72sdp"
            android:layout_height="wrap_content"
            android:text="@string/urge_caliber"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_12ssp" />

        <TextView
            android:id="@+id/tvCaliber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/navy"
            android:textSize="@dimen/_12ssp"
            tools:text="DN20" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="@dimen/_72sdp"
            android:layout_height="wrap_content"
            android:text="@string/urge_fee_kind"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_12ssp" />

        <TextView
            android:id="@+id/tvFeeKind"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/navy"
            android:textSize="@dimen/_12ssp"
            tools:text="居民" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="@dimen/_72sdp"
            android:layout_height="wrap_content"
            android:text="@string/urge_fee_state"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_12ssp" />

        <TextView
            android:id="@+id/tvFeeState"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/navy"
            android:textSize="@dimen/_12ssp"
            tools:text="计费" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="@dimen/_72sdp"
            android:layout_height="wrap_content"
            android:text="@string/urge_charge_way"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_12ssp" />

        <TextView
            android:id="@+id/tvChargeWay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/navy"
            android:textSize="@dimen/_12ssp"
            tools:text="后付费" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="@dimen/_72sdp"
            android:layout_height="wrap_content"
            android:text="@string/urge_reading"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_12ssp" />

        <TextView
            android:id="@+id/tvReading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/navy"
            android:textSize="@dimen/_12ssp"
            tools:text="1234" />

        <TextView
            android:id="@+id/tvReadHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/_6sdp"
            android:text="@string/urge_read_history"
            android:textColor="@color/primary"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="@dimen/_72sdp"
            android:layout_height="wrap_content"
            android:text="@string/urge_read_date"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_12ssp" />

        <TextView
            android:id="@+id/tvReadDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/navy"
            android:textSize="@dimen/_12ssp"
            tools:text="2024-08-01" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="@dimen/_72sdp"
            android:layout_height="wrap_content"
            android:text="@string/urge_valve_state"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_12ssp" />

        <TextView
            android:id="@+id/tvValveState"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/navy"
            android:textSize="@dimen/_12ssp"
            tools:text="开" />

        <TextView
            android:id="@+id/tvSwitchValve"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/_6sdp"
            android:text="@string/urge_switch_valve"
            android:textColor="@color/primary"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="@dimen/_72sdp"
            android:layout_height="wrap_content"
            android:text="@string/urge_use_state"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_12ssp" />

        <TextView
            android:id="@+id/tvUseState"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/navy"
            android:textSize="@dimen/_12ssp"
            tools:text="在用" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="@dimen/_72sdp"
            android:layout_height="wrap_content"
            android:text="@string/urge_book"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_12ssp" />

        <TextView
            android:id="@+id/tvBook"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/navy"
            android:textSize="@dimen/_12ssp"
            tools:text="南山花园 1 册" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="@dimen/_72sdp"
            android:layout_height="wrap_content"
            android:text="@string/urge_meter_remark"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_12ssp" />

        <TextView
            android:id="@+id/tvRemark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/navy"
            android:textSize="@dimen/_12ssp"
            tools:text="门口有狗" />

        <TextView
            android:id="@+id/tvEditRemark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/_6sdp"
            android:text="@string/urge_edit"
            android:textColor="@color/primary"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
